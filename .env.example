# DATABASE_URL: Connection string PostgreSQL dari Supabase.
# Gunakan URL Transaction Pooler atau Session Pooler dari tombol "Connect" di Dashboard Supabase
# (contoh: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres)
# Catatan: Saat DATABASE_URL kosong pada environment lokal, aplikasi otomatis menggunakan SQLite (data/inventory.db).
DATABASE_URL=""

# ADMIN_TOKEN_SECRET: Kunci rahasia acak untuk menandatangani token sesi Admin di Vercel Serverless.
ADMIN_TOKEN_SECRET="change-this-to-a-long-random-secret"

# ADMIN_PIN: PIN awal Admin saat database pertama kali dibuat (default: 1234).
ADMIN_PIN="1234"
