{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized Firebase UID granted full administrative access to inventory master data, sessions, and PIN configuration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the admin user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the admin user.",
          "maxLength": 200
        },
        "added_by_uid": {
          "type": "string",
          "description": "UID of the admin who added this admin record.",
          "maxLength": 128
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "added_by_uid", "workspace", "created_at"]
    },
    "AppSecurityConfig": {
      "title": "AppSecurityConfig",
      "description": "Global application configuration storing the SHA-256 hash of the Admin Mode PIN.",
      "type": "object",
      "properties": {
        "pin_hash": {
          "type": "string",
          "description": "SHA-256 hex digest of the 4-8 digit Admin Mode PIN.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "updated_by_uid": {
          "type": "string",
          "description": "UID of the admin who last updated the PIN.",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when config was created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when config was last updated."
        }
      },
      "required": ["pin_hash", "workspace", "updated_by_uid", "created_at", "updated_at"]
    },
    "InventoryLocation": {
      "title": "InventoryLocation",
      "description": "Factory warehouse or production area location used to group and tag opname sheets.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Numeric identifier preserved for UI compatibility."
        },
        "code": {
          "type": "string",
          "description": "Short uppercase location code (e.g. ASSY, BLANK, WH).",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Human-readable location name.",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Optional notes describing the location.",
          "maxLength": 300
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "created_by_uid": {
          "type": "string",
          "description": "UID of the admin who created this location.",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "description",
        "workspace",
        "created_by_uid",
        "created_at",
        "updated_at"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Finished fishing rod model master record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Numeric product identifier."
        },
        "sap_code": {
          "type": "string",
          "description": "SAP code of the finished good model.",
          "minLength": 1,
          "maxLength": 64
        },
        "model_name": {
          "type": "string",
          "description": "Full fishing rod model name.",
          "minLength": 1,
          "maxLength": 160
        },
        "location": {
          "type": "string",
          "description": "Default location code.",
          "maxLength": 64
        },
        "section": {
          "type": "string",
          "description": "Section classification (default SET).",
          "minLength": 1,
          "maxLength": 64
        },
        "is_active": {
          "type": "boolean",
          "description": "Whether this model is active in new opname sessions."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "created_by_uid": {
          "type": "string",
          "description": "UID of the admin who created this product.",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "sap_code",
        "model_name",
        "location",
        "section",
        "is_active",
        "workspace",
        "created_by_uid",
        "created_at",
        "updated_at"
      ]
    },
    "ProductPart": {
      "title": "ProductPart",
      "description": "Component or part belonging to a fishing rod model.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Numeric part identifier."
        },
        "product_id": {
          "type": "integer",
          "description": "Numeric ID of the parent Product."
        },
        "product_doc_id": {
          "type": "string",
          "description": "Firestore document ID of the parent Product.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sn_order": {
          "type": "integer",
          "description": "Sequence number within the model BOM."
        },
        "sap_code": {
          "type": "string",
          "description": "SAP code of the part.",
          "minLength": 1,
          "maxLength": 64
        },
        "parts_name": {
          "type": "string",
          "description": "Part name.",
          "minLength": 1,
          "maxLength": 200
        },
        "section": {
          "type": "string",
          "description": "Assembly section of the part.",
          "maxLength": 64
        },
        "use_qty": {
          "type": "number",
          "description": "Bill-of-materials usage quantity per finished set (nullable)."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "created_by_uid": {
          "type": "string",
          "description": "UID of the admin who created this part.",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "product_id",
        "product_doc_id",
        "sn_order",
        "sap_code",
        "parts_name",
        "section",
        "use_qty",
        "workspace",
        "created_by_uid",
        "created_at",
        "updated_at"
      ]
    },
    "OpnameSession": {
      "title": "OpnameSession",
      "description": "Monthly stock-opname counting session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Numeric session identifier."
        },
        "period_label": {
          "type": "string",
          "description": "Display label for the period (e.g. November 2026).",
          "minLength": 1,
          "maxLength": 80
        },
        "period_month": {
          "type": "string",
          "description": "Month key in YYYY-MM format.",
          "pattern": "^[0-9]{4}-[0-9]{2}$",
          "maxLength": 16
        },
        "opname_date": {
          "type": "string",
          "description": "Short DD.MM.YY opname sheet date.",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Session lifecycle status.",
          "enum": ["active", "closed"]
        },
        "prepared_by": {
          "type": "string",
          "description": "Operator name who most recently submitted in this session.",
          "maxLength": 120
        },
        "submitted_at": {
          "type": "string",
          "description": "ISO timestamp of most recent submission (nullable).",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "description": "Session notes.",
          "maxLength": 500
        },
        "closed_at": {
          "type": "string",
          "description": "ISO timestamp when session was closed (nullable).",
          "maxLength": 64
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "created_by_uid": {
          "type": "string",
          "description": "UID of the admin who created this session.",
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "period_label",
        "period_month",
        "opname_date",
        "status",
        "prepared_by",
        "submitted_at",
        "notes",
        "closed_at",
        "workspace",
        "created_by_uid",
        "created_at",
        "updated_at"
      ]
    },
    "OpnameEntry": {
      "title": "OpnameEntry",
      "description": "Individual finished-good or part stock-opname count row inside a session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Numeric entry identifier."
        },
        "session_id": {
          "type": "integer",
          "description": "Numeric ID of parent OpnameSession."
        },
        "session_doc_id": {
          "type": "string",
          "description": "Firestore document ID of parent OpnameSession.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "product_id": {
          "type": "integer",
          "description": "Numeric ID of associated Product."
        },
        "product_doc_id": {
          "type": "string",
          "description": "Firestore document ID of associated Product.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "part_id": {
          "type": "integer",
          "description": "Numeric ID of associated ProductPart, or null for finished good."
        },
        "sn_order": {
          "type": "integer",
          "description": "Row order within model sheet."
        },
        "item_type": {
          "type": "string",
          "description": "Row type.",
          "enum": ["finished_good", "part"]
        },
        "model_name": {
          "type": "string",
          "description": "Model name snapshot.",
          "minLength": 1,
          "maxLength": 160
        },
        "location": {
          "type": "string",
          "description": "Location code assigned to this sheet.",
          "maxLength": 64
        },
        "sap_code": {
          "type": "string",
          "description": "SAP code snapshot.",
          "minLength": 1,
          "maxLength": 64
        },
        "parts_name": {
          "type": "string",
          "description": "Part or finished good name snapshot.",
          "minLength": 1,
          "maxLength": 200
        },
        "section": {
          "type": "string",
          "description": "Section snapshot.",
          "maxLength": 64
        },
        "use_qty": {
          "type": "number",
          "description": "Usage quantity snapshot (nullable)."
        },
        "qty_ok": {
          "type": "integer",
          "description": "Counted OK quantity column 1 (nullable)."
        },
        "qty_ok_2": {
          "type": "integer",
          "description": "Counted OK quantity column 2 (nullable)."
        },
        "qty_nc": {
          "type": "integer",
          "description": "Counted Non-Conforming quantity (nullable)."
        },
        "total_qty": {
          "type": "integer",
          "description": "Computed total quantity (nullable)."
        },
        "operator_name": {
          "type": "string",
          "description": "Operator name who submitted the sheet.",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "description": "Row notes.",
          "maxLength": 500
        },
        "is_submitted": {
          "type": "boolean",
          "description": "Whether the sheet row is locked after submission."
        },
        "submitted_at": {
          "type": "string",
          "description": "ISO submission timestamp (nullable).",
          "maxLength": 64
        },
        "submitted_by_uid": {
          "type": "string",
          "description": "Firebase UID of user who submitted (nullable).",
          "maxLength": 128
        },
        "updated_by_uid": {
          "type": "string",
          "description": "Firebase UID of user who last updated this entry (nullable).",
          "maxLength": 128
        },
        "workspace": {
          "type": "string",
          "description": "Workspace scope identifier.",
          "enum": ["sinyotama"],
          "maxLength": 32
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "session_id",
        "session_doc_id",
        "product_id",
        "product_doc_id",
        "part_id",
        "sn_order",
        "item_type",
        "model_name",
        "location",
        "sap_code",
        "parts_name",
        "section",
        "use_qty",
        "qty_ok",
        "qty_ok_2",
        "qty_nc",
        "total_qty",
        "operator_name",
        "notes",
        "is_submitted",
        "submitted_at",
        "submitted_by_uid",
        "updated_by_uid",
        "workspace",
        "created_at",
        "updated_at"
      ]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Explicit admin UID allowlist documents."
    },
    "/app_config/{configId}": {
      "schema": {
        "$ref": "#/entities/AppSecurityConfig"
      },
      "description": "Application security settings including Admin Mode PIN hash."
    },
    "/locations/{locationId}": {
      "schema": {
        "$ref": "#/entities/InventoryLocation"
      },
      "description": "Master warehouse and factory location records."
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Master fishing rod finished-good models."
    },
    "/parts/{partId}": {
      "schema": {
        "$ref": "#/entities/ProductPart"
      },
      "description": "Master BOM parts linked to products."
    },
    "/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/OpnameSession"
      },
      "description": "Monthly stock-opname sessions."
    },
    "/entries/{entryId}": {
      "schema": {
        "$ref": "#/entities/OpnameEntry"
      },
      "description": "Stock-opname count rows per session, model, and location."
    }
  }
}
